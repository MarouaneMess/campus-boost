{
  "name": "campus-boost",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Campus Boost — les entreprises et les talents de demain.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "test:e2e": "playwright test",
    "prepare:brand": "node scripts/prepare-brand.mjs",
    "prepare:documents": "node scripts/prepare-documents.mjs",
    "format": "prettier --write src tests scripts public/sw.js *.ts *.mjs *.json README.md"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/postcss": "^4.3.5",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.182.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
